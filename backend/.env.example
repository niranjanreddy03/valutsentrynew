# =============================================================
# Vault Sentry — Backend Environment Variables
# Copy this file to backend/.env and fill in every value.
# Never commit backend/.env to git.
# =============================================================


# -------------------------------------------------------------
# APPLICATION
# -------------------------------------------------------------
APP_NAME=Vault Sentry
APP_VERSION=1.0.0
DEBUG=false
ENVIRONMENT=production          # development | production


# -------------------------------------------------------------
# SERVER
# -------------------------------------------------------------
HOST=0.0.0.0
PORT=8000


# -------------------------------------------------------------
# SECURITY
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
# This is the fallback local encryption key (v1/v2 blobs).
# Once KMS is active, new tokens no longer rely on this key,
# but you must keep the same value so old blobs can still decrypt.
# -------------------------------------------------------------
SECRET_KEY=replace-with-64-char-random-string

ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7


# -------------------------------------------------------------
# DATABASE
# Use SQLite locally, Supabase Postgres in production.
# -------------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST:5432/DBNAME
# DATABASE_URL=sqlite+aiosqlite:///./secret_sentry.db   # local dev
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20


# -------------------------------------------------------------
# SUPABASE
# Get these from: Supabase dashboard → Project Settings → API
# -------------------------------------------------------------
SUPABASE_URL=https://YOUR-PROJECT-ID.supabase.co
SUPABASE_KEY=your-anon-public-key
SUPABASE_SERVICE_KEY=your-service-role-secret-key

# JWT secret: Supabase dashboard → Project Settings → API → JWT Secret
# Required in production so the backend can verify Supabase auth tokens.
SUPABASE_JWT_SECRET=your-supabase-jwt-secret
SUPABASE_JWT_AUDIENCE=authenticated


# -------------------------------------------------------------
# REDIS
# Render injects REDIS_URL automatically when a Redis instance is linked.
# -------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0


# -------------------------------------------------------------
# CORS
# Comma-separated list of allowed frontend origins. Never use "*".
# -------------------------------------------------------------
CORS_ORIGINS=https://your-app.vercel.app,http://localhost:3000


# -------------------------------------------------------------
# AWS + KMS
# IAM user must have: kms:GenerateDataKey, kms:Decrypt, kms:DescribeKey
# KMS_KEY_ID: the key ID or alias/ARN from the KMS console.
# -------------------------------------------------------------
AWS_ACCESS_KEY_ID=AKIAxxxxxxxxxxxxxxxxx
AWS_SECRET_ACCESS_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
AWS_REGION=us-east-1
KMS_KEY_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx


# -------------------------------------------------------------
# GITHUB INTEGRATION
# GITHUB_TOKEN: a PAT used by the backend to clone private repos.
# GITHUB_CLIENT_ID / SECRET: only needed for GitHub OAuth app login.
# GITHUB_WEBHOOK_SECRET: only needed if you use GitHub webhooks.
# -------------------------------------------------------------
GITHUB_TOKEN=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_WEBHOOK_SECRET=


# -------------------------------------------------------------
# EMAIL (alerts / notifications)
# -------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@yourdomain.com
SMTP_PASSWORD=your-smtp-password
EMAIL_FROM=alerts@yourdomain.com


# -------------------------------------------------------------
# SLACK (optional — policy alert webhooks)
# -------------------------------------------------------------
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/xxx/yyy/zzz


# -------------------------------------------------------------
# RATE LIMITING
# -------------------------------------------------------------
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60
