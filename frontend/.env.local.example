# =============================================================
# Vault Sentry — Frontend Environment Variables
# Copy this file to frontend/.env.local for local dev.
# In production (Vercel) set these in:
#   Vercel dashboard → Project → Settings → Environment Variables
# Never commit frontend/.env.local to git.
# =============================================================


# -------------------------------------------------------------
# BACKEND API
# Public URL of the FastAPI backend (Render, or localhost for dev).
# -------------------------------------------------------------
NEXT_PUBLIC_API_URL=https://vaultsentry-api.onrender.com
# NEXT_PUBLIC_API_URL=http://localhost:8000   # local dev


# -------------------------------------------------------------
# SUPABASE — PUBLIC (safe to expose in browser)
# Get from: Supabase dashboard → Project Settings → API
# -------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ID.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key


# -------------------------------------------------------------
# SUPABASE — SERVER ONLY (Next.js API routes only, never NEXT_PUBLIC_)
# Service-role key bypasses Row Level Security — keep secret.
# -------------------------------------------------------------
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key


# -------------------------------------------------------------
# EMAIL (MFA disable verification codes via Resend)
# Sign up at resend.com → API Keys → Create key
# -------------------------------------------------------------
RESEND_API_KEY=re_your_resend_api_key
SUPPORT_FROM_ADDRESS=VaultSentry <support@your-verified-domain.com>
