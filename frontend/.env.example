# Frontend env. Copy to frontend/.env.local for local dev. In production
# (Vercel), set these in the Vercel project Settings → Environment Variables.

# Public URL of the FastAPI backend on Render
NEXT_PUBLIC_API_URL=https://vaultsentry-api.onrender.com

# Supabase (public/anon credentials only — never put service-role keys here)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Optional but recommended for deployed OAuth/password reset redirects.
# Example: https://your-amplify-domain.amplifyapp.com
NEXT_PUBLIC_SITE_URL=

# Server-only values used by Next.js API routes. Do not expose these with
# NEXT_PUBLIC_ and do not commit real values.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Email provider for MFA disable verification codes.
RESEND_API_KEY=re_your_resend_api_key
SUPPORT_FROM_ADDRESS="VaultSentry <support@your-verified-domain.com>"
